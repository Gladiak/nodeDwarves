{
  "name": "nodedwarves",
  "version": "2.0.0",
  "main": "app.js",
  "scripts": {
    "ai:bootstrap": "python3 python/bootstrap.py",
    "ai:agent": "npm run ai:bootstrap --silent && ./.venv/bin/python python/agent.py",
    "ai:play": "node app.js --ai models/policy_best.json",
    "ai:server": "node ai_server.js",
    "ai:train": "node scripts/train_wrapper.js fast",
    "ai:train:fresh": "node scripts/train_wrapper.js fast --fresh",
    "ai:train:fast": "node scripts/train_wrapper.js fast",
    "ai:train:fast:quality": "node scripts/train_wrapper.js quality",
    "ai:train:full": "node scripts/train_wrapper.js full",
    "ai:train:full:fresh": "node scripts/train_wrapper.js full --fresh",
    "ai:train:endgame": "node scripts/train_wrapper.js endgame",
    "ai:train:benchmark": "node scripts/train_wrapper.js benchmark",
    "ai:promote:best": "npm run ai:bootstrap --silent && ./.venv/bin/python python/promote_best.py",
    "ai:regression": "node scripts/regression.js --all",
    "ai:regression:record": "node scripts/regression.js --record --profile standard",
    "start": "node app.js",
    "map:export": "node scripts/export_map.js",
    "map:export:seasons": "node scripts/export_map.js --season=all",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "puppeteer": "^24.36.1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": ""
}
