start_time=2026-01-26 18:16:15
config=config.json
settings episodes=5000 max_steps=900 step_ticks=5 batch_episodes=8 workers=8 gamma=0.99 gae_lambda=0.95 clip_range=0.2 entropy_coef=0.005 value_coef=0.5 lr=0.0003 lr_final=0.0001 difficulty_start=0.03 difficulty_end=1.0 difficulty_ramp=50000 min_weight=0.0 max_weight=2.0
resources=food_raw stone water wood
scenarios=baseline:0.30 water_scarce:0.20 food_scarce:0.20 low_stockpile:0.15 housing_pressure:0.15
